# =========================================================
# AURA ERP - PRODUCTION ENVIRONMENT TEMPLATE
# Copy to `.env.production`, `.env.staging` or `.env.development`
# =========================================================

# --- ENVIRONMENT ---
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# --- DATABASE ---
DATABASE_URL="postgresql://aura:securepassword@db:5432/aura_erp?schema=public&pool_timeout=10"
POSTGRES_USER=aura
POSTGRES_PASSWORD=securepassword
POSTGRES_DB=aura_erp

# --- REDIS CACHE / BULLMQ ---
REDIS_URL="redis://redis:6379"

# --- AUTHENTICATION ---
JWT_SECRET="generate_a_secure_random_base64_string_here_for_jwt"
NEXTAUTH_SECRET="generate_another_secure_string_here"
NEXTAUTH_URL="https://erp.yourdomain.com"
ADMIN_INITIAL_PASSWORD="ChangeMeInProduction123!"

# --- AWS / S3 / CLOUDFLARE R2 / MINIO (STORAGE) ---
AWS_ACCESS_KEY_ID="your_access_key"
AWS_SECRET_ACCESS_KEY="your_secret_key"
AWS_REGION="us-east-1" # Or auto for R2
AWS_BUCKET_NAME="aura-erp-prod-bucket"
AWS_ENDPOINT_URL="" # Set this if using Cloudflare R2 or MinIO

# --- COMMUNICATION (SMTP / SMS / WHATSAPP) ---
SMTP_HOST="smtp.amazon.ses.com"
SMTP_PORT=465
SMTP_USER="smtp-username"
SMTP_PASS="smtp-password"
SMTP_FROM_EMAIL="noreply@yourdomain.com"

SMS_API_KEY="msg91_or_fast2sms_api_key_here"
WHATSAPP_TOKEN="meta_whatsapp_cloud_auth_token"
WHATSAPP_NUMBER_ID="your_phone_number_id"

# --- STRIPE / RAZORPAY ---
PAYMENT_GATEWAY_KEY="rzp_live_xxxxxxxxxxx"
PAYMENT_GATEWAY_SECRET="your_razorpay_secret"
PAYMENT_WEBHOOK_SECRET="webhook_verification_secret"

# --- CRON JOBS / SYSTEM BACKUP ---
CRON_SECRET="secret_for_hitting_cron_endpoints"
BACKUP_ENCRYPTION_KEY="32_byte_aes_key_for_pg_dump"
