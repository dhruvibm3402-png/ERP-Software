  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  Department  Department    @relation(fields: [departmentId], references: [id])
  EmployeeExt EmployeeExt[]
}

// EmployeeExt extends the existing Employee model with HR-specific fields
// It links 1:1 with Employee via employeeId
model EmployeeExt {
  id                    String    @id @default(cuid())
  employeeId            String    @unique
  // Personal
  firstName             String
  lastName              String
  gender                String? // MALE | FEMALE | OTHER
  dateOfBirth           DateTime?
  bloodGroup            String?
  profileImage          String?
  aadhaarNumber         String?
  panNumber             String?
  address               String?
  city                  String?
  state                 String?
  country               String    @default("India")
  pincode               String?
  // Emergency
  emergencyContactName  String?
  emergencyContactPhone String?
  // Employment
  departmentId          String?
  designationId         String?
  branchId              String?
  managerId             String? // employeeId of manager
  employmentType        String    @default("FULL_TIME") // FULL_TIME | PART_TIME | CONTRACT | INTERN
  salaryType            String    @default("MONTHLY") // MONTHLY | DAILY | HOURLY
  // Bank
  bankName              String?
  accountHolderName     String?
  accountNumber         String?
  ifscCode              String?
  upiId                 String?
  // Other
  notes                 String?
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  Employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  Department  Department?  @relation(fields: [departmentId], references: [id])
  Designation Designation? @relation(fields: [designationId], references: [id])
}

