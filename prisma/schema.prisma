generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AccountingEntry {
  id          String   @id @default(cuid())
  type        String
  category    String
  amount      Float
  description String?
  referenceId String?
  createdAt   DateTime @default(now())
}

model Attendance {
  id         String    @id @default(cuid())
  employeeId String
  date       DateTime
  punchIn    DateTime?
  punchOut   DateTime?
  status     String    @default("PRESENT")
  deviceId   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  Employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String
  userId    String?
  details   String?
  createdAt DateTime @default(now())
  User      User?    @relation(fields: [userId], references: [id])
}

model Branch {
  id            String    @id @default(cuid())
  code          String?   @unique
  name          String    @unique
  location      String?
  status        String    @default("ACTIVE") // ACTIVE | INACTIVE
  managerId     String? // Links to Employee or User
  contactNumber String?
  email         String?
  address       String?
  gstNumber     String?
  isDefault     Boolean   @default(false)
  tenantId      String? // Tenant isolation
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  CustomOrder                                        CustomOrder[]
  GoldExchange                                       GoldExchange[]
  Inventory                                          Inventory[]
  InventoryAudit                                     InventoryAudit[]
  InventoryMovement                                  InventoryMovement[]
  Product                                            Product[]
  PurchaseOrder                                      PurchaseOrder[]
  SaleInvoice                                        SaleInvoice[]
  StockAdjustment                                    StockAdjustment[]
  StockTransfer_StockTransfer_destBranchIdToBranch   StockTransfer[]     @relation("StockTransfer_destBranchIdToBranch")
  StockTransfer_StockTransfer_sourceBranchIdToBranch StockTransfer[]     @relation("StockTransfer_sourceBranchIdToBranch")
  BranchSettings                                     BranchSettings?
}

model BranchSettings {
  id          String   @id @default(cuid())
  branchId    String   @unique
  openTime    String   @default("09:00")
  closeTime   String   @default("21:00")
  workingDays String   @default("MON,TUE,WED,THU,FRI,SAT") // Comma-separated
  config      String? // JSON configs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model CustomOrder {
  id                       String                     @id @default(cuid())
  orderNumber              String                     @unique
  customerId               String
  branchId                 String?
  status                   String                     @default("DRAFT")
  description              String?
  targetDate               DateTime?
  deliveredDate            DateTime?
  estimatedTotal           Float                      @default(0)
  advancePaid              Float                      @default(0)
  balance                  Float                      @default(0)
  productId                String?                    @unique
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  Branch                   Branch?                    @relation(fields: [branchId], references: [id])
  Customer                 Customer                   @relation(fields: [customerId], references: [id])
  Product                  Product?                   @relation(fields: [productId], references: [id])
  CustomOrderApproval      CustomOrderApproval[]
  CustomOrderEmployee      CustomOrderEmployee[]
  CustomOrderImage         CustomOrderImage[]
  CustomOrderItem          CustomOrderItem[]
  CustomOrderMaterial      CustomOrderMaterial[]
  CustomOrderPayment       CustomOrderPayment[]
  CustomOrderQuotation     CustomOrderQuotation[]
  CustomOrderStatusHistory CustomOrderStatusHistory[]
  CustomOrderTimeline      CustomOrderTimeline[]
}

model CustomOrderApproval {
  id            String      @id @default(cuid())
  customOrderId String
  stage         String
  status        String
  approvedBy    String?
  remarks       String?
  approvedAt    DateTime?
  createdAt     DateTime    @default(now())
  CustomOrder   CustomOrder @relation(fields: [customOrderId], references: [id], onDelete: Cascade)
}

model CustomOrderEmployee {
  id            String      @id @default(cuid())
  customOrderId String
  employeeId    String
  role          String
  assignedAt    DateTime    @default(now())
  CustomOrder   CustomOrder @relation(fields: [customOrderId], references: [id], onDelete: Cascade)
  Employee      Employee    @relation(fields: [employeeId], references: [id])
}

model CustomOrderImage {
  id            String      @id @default(cuid())
  customOrderId String
  url           String
  fileType      String?
  fileName      String?
  uploadedBy    String?
  createdAt     DateTime    @default(now())
  CustomOrder   CustomOrder @relation(fields: [customOrderId], references: [id], onDelete: Cascade)
}

model CustomOrderItem {
  id             String      @id @default(cuid())
  customOrderId  String
  itemName       String
  category       String?
  description    String?
  metal          String?
  purity         String?
  expectedWeight Float?
  diamondWeight  Float?
  stoneWeight    Float?
  makingCharges  Float?
  totalPrice     Float?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  CustomOrder    CustomOrder @relation(fields: [customOrderId], references: [id], onDelete: Cascade)
}

model CustomOrderMaterial {
  id            String      @id @default(cuid())
  customOrderId String
  materialType  String
  weight        Float
  quantity      Int         @default(1)
  purity        String?
  allocatedAt   DateTime    @default(now())
  CustomOrder   CustomOrder @relation(fields: [customOrderId], references: [id], onDelete: Cascade)
}

model CustomOrderPayment {
  id            String      @id @default(cuid())
  customOrderId String
  amount        Float
  method        String
  reference     String?
  type          String      @default("ADVANCE")
  paymentDate   DateTime    @default(now())
  createdAt     DateTime    @default(now())
  CustomOrder   CustomOrder @relation(fields: [customOrderId], references: [id], onDelete: Cascade)
}

model CustomOrderQuotation {
  id            String      @id @default(cuid())
  customOrderId String
  goldWeight    Float?
  diamondWeight Float?
  stoneWeight   Float?
  makingCharges Float?
  labourCharges Float?
  designCharges Float?
  gstAmount     Float?
  discount      Float?
  advanceAmount Float?
  grandTotal    Float
  pdfUrl        String?
  status        String      @default("GENERATED")
  createdAt     DateTime    @default(now())
  CustomOrder   CustomOrder @relation(fields: [customOrderId], references: [id], onDelete: Cascade)
}

model CustomOrderStatusHistory {
  id            String      @id @default(cuid())
  customOrderId String
  fromStatus    String?
  toStatus      String
  changedBy     String?
  remarks       String?
  changedAt     DateTime    @default(now())
  CustomOrder   CustomOrder @relation(fields: [customOrderId], references: [id], onDelete: Cascade)
}

model CustomOrderTimeline {
  id            String      @id @default(cuid())
  customOrderId String
  action        String
  remarks       String?
  performedBy   String?
  createdAt     DateTime    @default(now())
  CustomOrder   CustomOrder @relation(fields: [customOrderId], references: [id], onDelete: Cascade)
}

model Customer {
  id                 String               @id @default(cuid())
  customerId         String               @unique
  name               String
  mobile             String
  email              String?
  address            String?
  gstNumber          String?
  aadhaar            String?
  pan                String?
  birthday           DateTime?
  anniversary        DateTime?
  notes              String?
  tier               String               @default("Silver")
  loyaltyPoints      Int                  @default(0)
  outstandingBalance Float                @default(0)
  totalSpent         Float                @default(0)
  lastVisit          DateTime             @default(now())
  isDeleted          Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  CustomOrder        CustomOrder[]
  GoldExchange       GoldExchange[]
  LoyaltyTransaction LoyaltyTransaction[]
  RepairJob          RepairJob[]
  SaleInvoice        SaleInvoice[]
  LoyaltyMember      LoyaltyMember?       @relation("CustomerLoyaltyMember")
  CustomerWallet     CustomerWallet?      @relation("CustomerWallet")
  RewardRedemption   RewardRedemption[]
  Coupon             Coupon[]
  ReferralsMade      Referral[]           @relation("ReferrerLinks")
}

model Employee {
  id                  String                @id @default(cuid())
  employeeId          String                @unique
  name                String
  mobile              String
  email               String?
  role                String
  department          String?
  isActive            Boolean               @default(true)
  joinDate            DateTime              @default(now())
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  baseSalary          Float                 @default(0)
  biometricId         String?               @unique
  Attendance          Attendance[]
  CustomOrderEmployee CustomOrderEmployee[]
  Leave               Leave[]
  Payroll             Payroll[]
  PerformanceReview   PerformanceReview[]
  RepairJob           RepairJob[]
  EmployeeExt         EmployeeExt?
  EmployeeDocument    EmployeeDocument[]
  EmployeeSalary      EmployeeSalary[]
}

model ExchangePayment {
  id           String       @id @default(cuid())
  exchangeId   String
  amount       Float
  method       String
  reference    String?
  type         String       @default("REFUND")
  createdAt    DateTime     @default(now())
  GoldExchange GoldExchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
}

model GoldExchange {
  id                  String             @id @default(cuid())
  exchangeNumber      String             @unique
  customerId          String
  status              String             @default("DRAFT")
  remarks             String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  approvedBy          String?
  balanceRefund       Float              @default(0)
  branchId            String?
  createdBy           String?
  linkedSaleInvoiceId String?
  totalExchangeValue  Float              @default(0)
  totalGrossWeight    Float              @default(0)
  totalNetWeight      Float              @default(0)
  ExchangePayment     ExchangePayment[]
  Branch              Branch?            @relation(fields: [branchId], references: [id])
  Customer            Customer           @relation(fields: [customerId], references: [id])
  SaleInvoice         SaleInvoice?       @relation(fields: [linkedSaleInvoiceId], references: [id])
  GoldExchangeItem    GoldExchangeItem[]
  GoldPurityTest      GoldPurityTest[]
  GoldReceipt         GoldReceipt[]
  GoldValuation       GoldValuation[]
}

model GoldExchangeItem {
  id             String       @id @default(cuid())
  exchangeId     String
  description    String?
  category       String
  grossWeight    Float
  stoneWeight    Float        @default(0)
  netWeight      Float
  hallmarkNumber String?
  itemName       String
  metalType      String
  purity         String?
  quantity       Int          @default(1)
  GoldExchange   GoldExchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
}

model GoldPurityTest {
  id            String       @id @default(cuid())
  exchangeId    String
  purityPercent Float
  karat         String
  testMethod    String
  testedBy      String?
  notes         String?
  createdAt     DateTime     @default(now())
  GoldExchange  GoldExchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
}

model GoldReceipt {
  id            String       @id @default(cuid())
  receiptNumber String       @unique
  exchangeId    String
  pdfUrl        String?
  issuedAt      DateTime     @default(now())
  GoldExchange  GoldExchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
}

model GoldValuation {
  id                 String       @id @default(cuid())
  exchangeId         String
  currentGoldRate    Float
  meltingLossPct     Float        @default(0)
  deductionPct       Float        @default(0)
  stoneDeduction     Float        @default(0)
  labourDeduction    Float        @default(0)
  finalGoldWeight    Float
  finalExchangeValue Float
  createdAt          DateTime     @default(now())
  GoldExchange       GoldExchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
}

model Inventory {
  id             String   @id @default(cuid())
  productId      String
  branchId       String?
  quantity       Int      @default(0)
  availableStock Int      @default(0)
  grossWeight    Float    @default(0)
  lastUpdated    DateTime @default(now())
  maximumStock   Int      @default(100)
  minimumStock   Int      @default(5)
  netWeight      Float    @default(0)
  reservedStock  Int      @default(0)
  status         String   @default("IN_STOCK")
  Branch         Branch?  @relation(fields: [branchId], references: [id])
  Product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model InventoryAudit {
  id                 String               @id @default(cuid())
  auditNumber        String               @unique
  branchId           String?
  auditDate          DateTime             @default(now())
  status             String               @default("DRAFT")
  remarks            String?
  completedBy        String?
  createdAt          DateTime             @default(now())
  Branch             Branch?              @relation(fields: [branchId], references: [id])
  InventoryAuditItem InventoryAuditItem[]
}

model InventoryAuditItem {
  id               String         @id @default(cuid())
  auditId          String
  productId        String
  expectedQuantity Int
  actualQuantity   Int
  difference       Int            @default(0)
  remarks          String?
  InventoryAudit   InventoryAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  Product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model InventoryMovement {
  id            String   @id @default(cuid())
  productId     String
  branchId      String?
  type          String
  quantity      Int      @default(0)
  weight        Float    @default(0)
  previousStock Int      @default(0)
  currentStock  Int      @default(0)
  referenceId   String?
  reason        String?
  userId        String?
  createdAt     DateTime @default(now())
  Branch        Branch?  @relation(fields: [branchId], references: [id])
  Product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model JobMaterial {
  id               String           @id @default(cuid())
  jobId            String
  type             String
  materialName     String
  weight           Float
  quantity         Int?             @default(1)
  purity           String?
  issuedDate       DateTime         @default(now())
  notes            String?
  ManufacturingJob ManufacturingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model JournalEntry {
  id          String        @id @default(cuid())
  entryNumber String        @unique
  date        DateTime      @default(now())
  reference   String?
  narration   String
  totalAmount Float         @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  JournalLine JournalLine[]
}

model JournalLine {
  id            String        @id @default(cuid())
  entryId       String
  accountId     String
  type          String
  amount        Float
  createdAt     DateTime      @default(now())
  LedgerAccount LedgerAccount @relation(fields: [accountId], references: [id])
  JournalEntry  JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
}

model Karigar {
  id               String             @id @default(cuid())
  karigarId        String             @unique
  name             String
  mobile           String
  type             String             @default("INTERNAL")
  specialty        String?
  address          String?
  balance          Float              @default(0)
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  ManufacturingJob ManufacturingJob[]
}

model Leave {
  id         String   @id @default(cuid())
  employeeId String
  type       String
  startDate  DateTime
  endDate    DateTime
  reason     String?
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  Employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model LedgerAccount {
  id          String        @id @default(cuid())
  code        String        @unique
  name        String
  type        String
  group       String?
  balance     Float         @default(0)
  isSystem    Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  JournalLine JournalLine[]
}

model LowStockRule {
  id           String  @id @default(cuid())
  productId    String  @unique
  minimumStock Int     @default(5)
  maximumStock Int     @default(100)
  safetyStock  Int     @default(10)
  notifyEmail  String?
  isActive     Boolean @default(true)
  Product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model LoyaltyTransaction {
  id          String   @id @default(cuid())
  customerId  String
  points      Int
  type        String
  description String
  createdAt   DateTime @default(now())
  Customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model ManufacturingJob {
  id               String        @id @default(cuid())
  jobNumber        String        @unique
  karigarId        String
  productName      String
  category         String
  metal            String?
  purity           String?
  expectedWeight   Float?
  quantity         Int           @default(1)
  status           String        @default("ASSIGNED")
  startDate        DateTime      @default(now())
  expectedDate     DateTime?
  completedDate    DateTime?
  qcStatus         String        @default("PENDING")
  qcNotes          String?
  qcBy             String?
  finalGrossWeight Float?
  finalNetWeight   Float?
  finalStoneWeight Float?
  makingCharge     Float?        @default(0)
  wastage          Float?        @default(0)
  productId        String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  JobMaterial      JobMaterial[]
  Karigar          Karigar       @relation(fields: [karigarId], references: [id])
  Product          Product?      @relation(fields: [productId], references: [id])
}

model NotificationLog {
  id          String   @id @default(cuid())
  targetPhone String?
  targetEmail String?
  type        String
  channel     String
  message     String
  status      String   @default("SENT")
  createdAt   DateTime @default(now())
}

model Payroll {
  id          String    @id @default(cuid())
  employeeId  String
  month       Int
  year        Int
  basicSalary Float
  incentives  Float     @default(0)
  deductions  Float     @default(0)
  netSalary   Float
  status      String    @default("PENDING")
  paidDate    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  Employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
}

model PerformanceReview {
  id         String   @id @default(cuid())
  employeeId String
  reviewDate DateTime @default(now())
  rating     Int
  comments   String?
  reviewer   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  Employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Product {
  id                 String               @id @default(cuid())
  sku                String               @unique
  barcode            String               @unique
  qrCode             String               @unique
  name               String
  category           String
  metal              String
  purity             String
  grossWeight        Float
  netWeight          Float
  stoneWeight        Float
  wastage            Float
  makingCharges      Float
  hsnCode            String?
  gst                Float
  images             String
  certificateNumber  String?
  hallmarkNumber     String?
  description        String?
  status             String               @default("Available")
  isDeleted          Boolean              @default(false)
  price              Float
  branchId           String?
  vendorId           String?
  stock              Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  CustomOrder        CustomOrder?
  Inventory          Inventory[]
  InventoryAuditItem InventoryAuditItem[]
  InventoryMovement  InventoryMovement[]
  LowStockRule       LowStockRule?
  ManufacturingJob   ManufacturingJob[]
  Branch             Branch?              @relation(fields: [branchId], references: [id])
  Vendor             Vendor?              @relation(fields: [vendorId], references: [id])
  PurchaseOrderItem  PurchaseOrderItem[]
  PurchaseReturnItem PurchaseReturnItem[]
  SaleItem           SaleItem[]
  SaleReturnItem     SaleReturnItem[]
  StockAdjustment    StockAdjustment[]
  StockMovement      StockMovement[]
  StockTransferItem  StockTransferItem[]
  Transaction        Transaction[]
}

model PurchaseDocument {
  id              String        @id @default(cuid())
  purchaseOrderId String
  url             String
  fileType        String?
  fileName        String?
  createdAt       DateTime      @default(now())
  PurchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
}

model PurchaseInvoice {
  id              String            @id @default(cuid())
  invoiceNumber   String            @unique
  purchaseOrderId String
  totalAmount     Float
  paidAmount      Float             @default(0)
  status          String            @default("UNPAID")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  PurchaseOrder   PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  PurchasePayment PurchasePayment[]
}

model PurchaseOrder {
  id                   String              @id @default(cuid())
  poNumber             String              @unique
  vendorId             String
  status               String              @default("DRAFT")
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  amountDue            Float               @default(0)
  amountPaid           Float               @default(0)
  branchId             String?
  createdBy            String?
  discountTotal        Float               @default(0)
  expectedDeliveryDate DateTime?
  grandTotal           Float               @default(0)
  gstTotal             Float               @default(0)
  makingChargesTotal   Float               @default(0)
  netPayable           Float               @default(0)
  paymentStatus        String              @default("PENDING")
  poDate               DateTime            @default(now())
  remarks              String?
  roundOff             Float               @default(0)
  subTotal             Float               @default(0)
  wastageTotal         Float               @default(0)
  PurchaseDocument     PurchaseDocument[]
  PurchaseInvoice      PurchaseInvoice[]
  Branch               Branch?             @relation(fields: [branchId], references: [id])
  VendorRecord         VendorRecord        @relation(fields: [vendorId], references: [id])
  PurchaseOrderItem    PurchaseOrderItem[]
  PurchaseReturn       PurchaseReturn[]
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  receivedQty     Int           @default(0)
  unitPrice       Float
  totalPrice      Float
  Product         Product       @relation(fields: [productId], references: [id])
  PurchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
}

model PurchasePayment {
  id              String          @id @default(cuid())
  invoiceId       String
  amount          Float
  paymentMode     String
  reference       String?
  paymentDate     DateTime        @default(now())
  PurchaseInvoice PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model PurchaseReturn {
  id                 String               @id @default(cuid())
  returnNumber       String               @unique
  purchaseOrderId    String
  reason             String?
  status             String               @default("PENDING")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  PurchaseOrder      PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id])
  PurchaseReturnItem PurchaseReturnItem[]
}

model PurchaseReturnItem {
  id             String         @id @default(cuid())
  returnId       String
  productId      String
  quantity       Int
  Product        Product        @relation(fields: [productId], references: [id])
  PurchaseReturn PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
}

model Vendor {
  id      String    @id @default(cuid())
  name    String
  contact String?
  Product Product[]
}

model VendorRecord {
  id                 String          @id @default(cuid())
  vendorCode         String          @unique
  vendorName         String
  companyName        String?
  vendorType         String
  contactPerson      String?
  mobile             String          @unique
  alternateMobile    String?
  email              String?
  website            String?
  gstNumber          String?         @unique
  panNumber          String?
  msmeNumber         String?
  paymentTerms       String?
  creditLimit        Float           @default(0)
  openingBalance     Float           @default(0)
  outstandingBalance Float           @default(0)
  address            String?
  city               String?
  state              String?
  country            String?         @default("India")
  pincode            String?
  bankName           String?
  accountHolderName  String?
  accountNumber      String?
  ifscCode           String?
  bankBranch         String?
  notes              String?
  status             String          @default("ACTIVE")
  createdBy          String?
  updatedBy          String?
  isDeleted          Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  PurchaseOrder      PurchaseOrder[]
  VendorLedger       VendorLedger[]
}

model VendorLedger {
  id           String       @id @default(cuid())
  vendorId     String
  date         DateTime     @default(now())
  type         String
  amount       Float
  balance      Float
  referenceId  String?
  description  String?
  VendorRecord VendorRecord @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model User {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  password               String
  name                   String
  role                   String                  @default("STAFF")
  roleId                 String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  tenantId               String?
  AuditLog               AuditLog[]
